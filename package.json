{
  "name": "elite-fire-and-protection",
  "version": "1.0.0",
  "description": "Premium production-ready static website with build-time SSG prerendering for Elite Fire and Protection, Faridabad & Delhi NCR",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:server-entry && node scripts/prerender.js",
    "build:client-only": "vite build",
    "build:server-entry": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "preview": "vite preview",
    "start": "vite preview",
    "test": "node scripts/test-static-routes.js"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
