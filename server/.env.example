# Elite Fire and Protection - Server Environment Configuration

# Server Port
PORT=5000

# Node Environment (development, production)
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated if multiple)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://elitefireandprotection.in

# MongoDB Connection String
# For local development: mongodb://127.0.0.1:27017/elite_fire_protection
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/elite_fire_protection?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/elite_fire_protection

# Fallback mode if MongoDB is not running locally (allows API testing without crashing)
ENABLE_OFFLINE_DB_FALLBACK=true

# Email Notification Configuration (Nodemailer / Transactional SMTP)
# Leave empty or set to 'smtp' / 'ethereal'
EMAIL_SERVICE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-business-email@example.com
SMTP_PASS=your-smtp-app-password
MAIL_FROM=Elite Fire and Protection <contact@elitefireandprotection.in>
MAIL_TO=alerts@elitefireandprotection.in

# Business Contact Fallback Configuration
BUSINESS_PHONE=+919800000000
BUSINESS_WHATSAPP=+919800000000
BUSINESS_EMAIL=contact@elitefireandprotection.in
